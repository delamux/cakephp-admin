#!/usr/bin/env sh
# Run on every deployment (the one-shot `migrate` service of compose.prod.yaml / compose.coolify.yaml):
# all migrations, then register new controller actions with their default permissions (idempotent).
# The table schema cache is cleared after migrating: with the code mounted (dev) it survives, and a
# stale one silently ignores new columns when saving.
set -e
cd "$(dirname "$0")/.."
bin/migrate
bin/cake schema_cache clear
bin/cake permissions sync
